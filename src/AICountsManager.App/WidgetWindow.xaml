<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AICountsManager" Width="382" Height="650" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Plate" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Plate" Property="BorderThickness" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="ToggleTrack" Height="17" CornerRadius="9" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Muted}" BorderThickness="1" VerticalAlignment="Center">
            <Ellipse x:Name="ToggleThumb" Width="9" Height="9" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
          </Border>
          <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource Accent}"/>
            <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource ToggleKnob}"/>
            <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
            <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="ToggleTrack" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Hover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="8,7"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
          <ScrollBar Style="{DynamicResource {x:Type ScrollBar}}" MinWidth="6" x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="6" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{DynamicResource ScrollThumb}" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Shell" Background="{DynamicResource ShellTint}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="14,12,14,10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Viewbox Width="25" Height="25" Margin="2,0,10,0" AutomationProperties.Name="Icono de AICountsManager">
          <Canvas Width="24" Height="24">
            <Path Data="M16,21 V19 C16,16.79 14.21,15 12,15 H6 C3.79,15 2,16.79 2,19 V21" Stroke="{DynamicResource Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M16,3.128 A4,4 0 0 1 16,10.872 M22,21 V19 C22,17.18 20.77,15.59 19,15.13" Stroke="{DynamicResource Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Ellipse Canvas.Left="4" Canvas.Top="2" Width="10" Height="10" Stroke="{DynamicResource Text}" StrokeThickness="2"/>
          </Canvas>
        </Viewbox>
        <TextBlock x:Name="TitleLabel" Grid.Column="1" Text="AICountsManager" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="AddButton" Grid.Column="2" Content="&#xE710;" Style="{StaticResource IconButton}" AutomationProperties.Name="Añadir cuenta" Margin="0,0,3,0"/>
        <Button x:Name="RefreshButton" Grid.Column="3" Content="&#xE72C;" Style="{StaticResource IconButton}" AutomationProperties.Name="Actualizar todas las cuentas" Margin="0,0,3,0"/>
        <Button x:Name="SettingsButton" Grid.Column="4" Content="&#xE713;" Style="{StaticResource IconButton}" AutomationProperties.Name="Ajustes"/>
      </Grid>
      <Grid Grid.Row="1" Margin="1,0,1,10">
        <TextBlock x:Name="SectionLabel" Text="CUENTAS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
        <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"/>
      </Grid>
      <ScrollViewer x:Name="AccountsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0" CanContentScroll="False">
        <StackPanel x:Name="DashboardStack">
        <StackPanel x:Name="AccountList"/>
      <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" Visibility="Collapsed" Margin="16,22">
        <TextBlock Text="Tu primera cuenta" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
        <TextBlock Text="Inicia sesión en Codex y guarda tu perfil para tenerlo siempre a mano." Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,4,0">
          <TextBlock Text="Proveedores" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <StackPanel x:Name="ProviderToggles"/>
          <TextBlock Text="Consulta los límites de la sesión guardada. El cambio de cuenta sigue disponible solo para Codex." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <TextBlock Text="Orden de las cuentas" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Text="Usa las flechas. El orden se conserva al cambiar de cuenta." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <StackPanel x:Name="OrderList" Margin="0,0,0,14"/>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,16"/>
          <TextBlock Text="Sesiones" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <CheckBox x:Name="StrictToggle" Content="Verificar la sesión antes de abrir Codex"/>
          <TextBlock Text="Comprueba la renovación al cambiar de cuenta. El cambio puede tardar unos segundos más." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="40,-4,0,20"/>
          <CheckBox x:Name="StartupToggle" Content="Iniciar AICountsManager con Windows"/>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,18"/>
          <TextBlock Text="Almacenamiento" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Tus perfiles se conservan en este equipo." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12"/>
          <Button x:Name="FolderButton" Content="Abrir carpeta de datos" HorizontalAlignment="Left" BorderThickness="1" Margin="0,0,0,8"/>
          <Button x:Name="FileModeButton" Content="Guardar sesiones en archivo" HorizontalAlignment="Left" BorderThickness="1"/>
          <TextBlock x:Name="SettingsSummary" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="3" Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Line}"/>
        <Grid Grid.Row="1" Margin="1,9,1,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="FooterLabel" Text="Sin cuentas guardadas" FontSize="10.5"/>
            <TextBlock x:Name="FooterUpdated" Text="Sin lecturas recientes" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock Text="Próximo reset" Foreground="{DynamicResource Muted}" FontSize="9.5" HorizontalAlignment="Right"/>
            <TextBlock x:Name="FooterReset" Text="—" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
